{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "RequireHttpsMetadata": true,
    "ValidAudiences": []
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-browse": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/catalog/courses",
          "Methods": [ "GET" ]
        }
      },
      "catalog-course": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/catalog/courses/{courseId}",
          "Methods": [ "GET" ]
        }
      },
      "certificate-verify": {
        "ClusterId": "certification",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/certificates/{certificateId}",
          "Methods": [ "GET" ]
        }
      },
      "authoring-courses": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Instructor",
        "Match": {
          "Path": "/api/v1/courses",
          "Methods": [ "GET", "POST" ]
        }
      },
      "authoring-course": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Instructor",
        "Match": {
          "Path": "/api/v1/courses/{id}",
          "Methods": [ "GET", "PATCH" ]
        }
      },
      "authoring-publish": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Instructor",
        "Match": {
          "Path": "/api/v1/courses/{id}/publish",
          "Methods": [ "POST" ]
        }
      },
      "authoring-republish": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Instructor",
        "Match": {
          "Path": "/api/v1/courses/{id}/republish",
          "Methods": [ "POST" ]
        }
      },
      "authoring-lessons": {
        "ClusterId": "course-authoring",
        "AuthorizationPolicy": "Instructor",
        "Match": {
          "Path": "/api/v1/courses/{id}/lessons/{**remainder}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },
      "enroll": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/enrollments",
          "Methods": [ "POST" ]
        }
      },
      "my-enrollments": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/enrollments",
          "Methods": [ "GET" ]
        }
      },
      "my-enrollment": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/enrollments/{courseId}",
          "Methods": [ "GET" ]
        }
      },
      "my-progress-list": {
        "ClusterId": "learning",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/course-progress",
          "Methods": [ "GET" ]
        }
      },
      "my-progress": {
        "ClusterId": "learning",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/course-progress/{courseId}",
          "Methods": [ "GET" ]
        }
      },
      "progress-complete-lesson": {
        "ClusterId": "learning",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/course-progress/{courseId}/completed-lessons",
          "Methods": [ "POST" ]
        }
      },
      "progress-completion": {
        "ClusterId": "learning",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/course-progress/{courseId}/completion",
          "Methods": [ "POST" ]
        }
      },
      "my-certificates": {
        "ClusterId": "certification",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/certificates",
          "Methods": [ "GET" ]
        }
      },
      "my-certificate": {
        "ClusterId": "certification",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/certificates/{certificateId}",
          "Methods": [ "GET" ]
        }
      },
      "courses-in-progress": {
        "ClusterId": "bff",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/me/courses-in-progress",
          "Methods": [ "GET" ]
        }
      },
      "purchase-start": {
        "ClusterId": "paid-enrollment",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/purchases",
          "Methods": [ "POST" ]
        }
      },
      "purchase-get": {
        "ClusterId": "paid-enrollment",
        "AuthorizationPolicy": "Student",
        "Match": {
          "Path": "/api/v1/purchases/{purchaseId}",
          "Methods": [ "GET" ]
        }
      },
      "purchase-resolutions": {
        "ClusterId": "paid-enrollment",
        "AuthorizationPolicy": "Administrator",
        "Match": {
          "Path": "/api/v1/purchases/{purchaseId}/resolutions",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "course-authoring": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5195"
          }
        }
      },
      "enrollment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5196"
          }
        }
      },
      "learning": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5197"
          }
        }
      },
      "certification": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5198"
          }
        }
      },
      "bff": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5199"
          }
        }
      },
      "paid-enrollment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5200"
          }
        }
      }
    }
  }
}
