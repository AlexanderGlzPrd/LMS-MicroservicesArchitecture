{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true
  },
  "ConnectionStrings": {
    "Enrollment": ""
  },
  "Services": {
    "CourseAuthoring": {
      "BaseUrl": "",
      "TimeoutSeconds": 3,
      "TotalTimeoutSeconds": 3,
